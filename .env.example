# ==============================================================================
# LunarNavi Environment Variables Configuration Template
# Copy this file to .env.local and populate with your Supabase project credentials.
#
# NOTE: If these variables are not provided, LunarNavi automatically operates in
# offline/local fallback mode using the verified local NASA datasets.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (anon/public key only)
# IMPORTANT: NEVER use or expose the service_role key in frontend code!
# Row Level Security (RLS) protects public read and permits anonymous run logging.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
